# Copiar a .env; no versionar secretos reales.
DATABASE_URL=postgresql://gestion:CAMBIAR@localhost:5432/gestion_documentos
BETTER_AUTH_URL=http://localhost:3000
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Adaptadores documentales: opcionales para el CRUD; no habilitan cargas por configurarse.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
DOCUMENT_FILES_MAX_BYTES=10485760
DOCUMENT_FILES_TIMEOUT_MS=30000
ANTIVIRUS_HOST=
ANTIVIRUS_PORT=3310
# Solo diagnóstico de red explícito, contra infraestructura aislada; nunca producción.
DOCUMENT_FILES_VERIFY_ISOLATED=false
# Tests contra una BD diferente a producción/desarrollo.
TEST_DATABASE_URL=
